  "designNotes": {
    "original": true,
    "source": "User-described two-layer urban topology; no imported IP map geometry or imagery.",
    "north": "1 is central apex; 2 west near A; 3 east near X. Direct center-to-1 street is unobstructed.",
    "south": "4 below the street in the C-Z folded corridor; 5/6 above ground at the staircase mouths. Enemy-facing buildings screen both mouths.",
    "rear": "B/Y cores sit far back behind dogleg shields; their valid spawns are forward near the central street. All cores remain destructible."
  }
